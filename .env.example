# Internal service. Do not put real secrets in git.
# NAME_FILE mounts win over NAME (Docker Swarm / GCP secret files).
# There is no DeepSeek / LLM vendor key here. That stays solely in proba-llm.

NODE_ENV=development
HOST=127.0.0.1
PORT=3700
LOG_LEVEL=info

# Hub → gateway service tokens (EdDSA). Audience is proba-gateway.
CALLER_ISSUERS=proba-hub
CALLER_SUBJECTS=hub
HUB_SERVICE_PUBLIC_KEY_FILE=/run/secrets/hub_service_jwks
HUB_ASSERTION_PUBLIC_KEY_FILE=/run/secrets/hub_assertion_jwks

# Gateway → proba-llm service tokens (EdDSA). iss/sub must match LLM allowlists.
LLM_BASE_URL=http://127.0.0.1:3600
LLM_ALLOWED_HOSTS=127.0.0.1:3600
LLM_TIMEOUT_MS=60000
GATEWAY_LLM_PRIVATE_KEY_FILE=/run/secrets/gateway_llm_private_key
GATEWAY_LLM_KEY_ID=gateway-llm-1
LLM_TOKEN_ISSUER=proba-gateway
LLM_TOKEN_SUBJECT=gateway
LLM_TOKEN_TTL_SECONDS=60

# Context bridge. budgetTokens is protocol; response-token reserve is local.
CONTEXT_BRIDGE_URL=http://127.0.0.1:3500
CONTEXT_ALLOWED_HOSTS=127.0.0.1:3500
CONTEXT_TIMEOUT_MS=10000
CONTEXT_MAX_BUDGET_TOKENS=4000

# Ads domain HTTP (optional). Empty = fail closed. Provider adapters are not in this process.
# ADS_DOMAIN_URL=http://127.0.0.1:3800
# ADS_DOMAIN_ALLOWED_HOSTS=127.0.0.1:3800
# ADS_DOMAIN_TIMEOUT_MS=15000
# ADS_TOKEN_AUDIENCE=proba-ads
# billing_eligibility is not exact_balance. Unknown provider funds refuse mutating Ads work.
# ADS_BILLING_REQUIREMENT=billing_eligibility
# ADS_PREFLIGHT_FRESHNESS_MS=15000

# Caps are configured limits, not a free quota. Omit USD ceiling to skip cost proofs.
GATEWAY_MAX_ITERATIONS=8
GATEWAY_MAX_LLM_CALLS=8
GATEWAY_MAX_TOOL_CALLS=16
GATEWAY_RESPONSE_TOKEN_RESERVE=512
# GATEWAY_MAX_COST_USD=
# GATEWAY_MAX_TOTAL_TOKENS=8000

AUDIT_PUBLISHER=redis
AUDIT_STREAM=proba.audit.events
# Swarm: REDIS_URL_FILE=/run/secrets/redis_url
AUDIT_CONTENT_ENABLED=true
AUDIT_CONTENT_MASK_PII=true
RUN_STORE_DIR=data/runs

# Refused if true
# INGRESS_PUBLIC=false
